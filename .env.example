# API origin only. Routes are mounted as:
#   /api
#   /v1/auth
#   /v1/habits
#   /v1/logs
#   /v1/today
#   /v1/stats
#   /v1/reminders
#   /v1/devices
#   /v1/pricing
#   /v1/admin/pricing
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000

# Google Sign-In (OAuth 2.0 client ID — Web application)
# Must match GOOGLE_CLIENT_ID in momentum-backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Demo login shortcuts (login page, non-production by default)
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
# NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer@momentum.app
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@momentum.app
# NEXT_PUBLIC_DEMO_PASSWORD=password123
