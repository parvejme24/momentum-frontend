# Local development — browser calls same-origin /v1/* (proxied by Next.js; no CORS).
# Server-side auth BFF uses BACKEND_URL directly.
NEXT_PUBLIC_API_URL=https://momentum-backend-czgu.onrender.com
BACKEND_URL=https://momentum-backend-czgu.onrender.com
# NEXT_PUBLIC_API_URL=http://localhost:4000
# BACKEND_URL=http://localhost:4000

# Google Sign-In (OAuth 2.0 client ID — Web application)
# Must match GOOGLE_CLIENT_ID in momentum-backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Demo login shortcuts (hidden in production unless enabled)
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
# NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer@momentum.app
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@momentum.app
# NEXT_PUBLIC_DEMO_PASSWORD=password123

# --- Vercel deployment (Project → Settings → Environment Variables) ---
#
# Required on Vercel:
#   NEXT_PUBLIC_API_URL=https://momentum-backend-czgu.onrender.com
#   BACKEND_URL=https://momentum-backend-czgu.onrender.com
#
# Also set on Render (momentum-backend env):
#   APP_URL=https://your-app.vercel.app
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
#   API_URL=https://momentum-backend-czgu.onrender.com
#
# Google Sign-In: add your Vercel URL to Authorized JavaScript origins in Google Cloud Console.
# Payments (SSLCommerz/Stripe): APP_URL must match the live frontend origin exactly.
